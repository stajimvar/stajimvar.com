# automation/.env — bu dosyayı .env olarak kopyalayıp doldur.
# .env git tarafından yok sayılır; service_role anahtarı asla commit edilmez
# ve asla tarayıcıya gönderilmez.

SUPABASE_URL=https://gdumgdgwlfnohkaucfow.supabase.co
# Supabase paneli → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Güvenlik şalterleri -----------------------------------------------------

# Yazma modu için zorunlu. Olmadan discover.py yalnızca --dry-run çalışır.
ALLOW_INSERT_UPDATE=false

# Kaynakta görülmeyen ilanları pasife alma. Kapalı başlaması bilinçli:
# ilk taramaların geçmişi birikmeden açılırsa her ilan "kaybolmuş" sayılır.
ALLOW_DEACTIVATION=false

# Pasifleştirme açılsa bile yalnızca burada adı geçen kaynaklarda çalışır
# (fail-closed). Virgülle ayır: trendyol-lever,dreamgames-lever
DEACTIVATION_ENABLED_SOURCES=

# --- İsteğe bağlı ------------------------------------------------------------

# SmartRecruiters adaptörü yalnızca işletmenin verdiği anahtarla çalışır.
SMARTRECRUITERS_API_KEY=
